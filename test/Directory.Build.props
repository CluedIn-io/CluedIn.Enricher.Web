<Project>
    <Import Project="..\Directory.Build.props"/>

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!-- Package selection (xunit v2 vs v3) is done per test csproj, not here. Keeping xunit v3
         here would combine a non-CLUEDIN_V50 leg's xunit v2 include with an unconditional xunit
         v3 include, putting both generations in the compile references at once (CS0433). -->
</Project>
